# Copier ce fichier en .env.local (non versionné) et renseigner les valeurs.
# Clé API Resend : https://resend.com/api-keys
RESEND_API_KEY=
# Adresse qui reçoit les messages du formulaire
CONTACT_TO_EMAIL=
# Expéditeur (domaine vérifié dans Resend), ex. "ESEN Ambassadors <contact@ton-domaine.tn>"
CONTACT_FROM_EMAIL=
